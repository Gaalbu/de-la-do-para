{
  "uid": "dlp-recovery",
  "title": "Recuperação de compras",
  "tags": [
    "de-la-do-para",
    "recuperação"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Outbox: eventos pendentes",
      "description": "Eventos gravados na transação de negócio e ainda não publicados no Kafka.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_eventing_outbox_pending_count",
          "legendFormat": "pendentes"
        },
        {
          "refId": "B",
          "expr": "dlp_eventing_outbox_pending_attempts",
          "legendFormat": "tentativas acumuladas"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbox: idade do pendente mais antigo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_eventing_outbox_pending_oldest_age_seconds",
          "legendFormat": "idade"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumo: falhas por estado",
      "description": "RETRYING volta sozinho; QUARANTINED precisa de replay auditado (C82).",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_eventing_consumer_failures",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumo: tentativas gastas em retry",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_eventing_consumer_retrying_attempts",
          "legendFormat": "tentativas"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pagamentos que ainda exigem trabalho",
      "description": "UNKNOWN: consulta ao provedor; UNDER_REVIEW: operador; REFUND_REQUESTED: reembolso em andamento.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_payments_intents",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pagamentos: idade do mais antigo por estado",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_payments_intents_oldest_age_seconds",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Chamadas ao provedor em voo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_payments_operations_in_flight",
          "legendFormat": "em voo"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Notificações do provedor",
      "description": "RECEIVED aguardando confirmação por consulta; REVIEW para o operador.",
      "datasource": {
        "type": "prometheus",
        "uid": "dlp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dlp_payments_provider_events",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
  "editable": false
}

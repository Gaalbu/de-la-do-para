# Exemplo de ambiente local — De Lá do Pará
# Copie para `.env` (não versionado) e preencha localmente.
# Nenhum valor real deve ser commitado. Sandbox é opt-in (C04).

# PostgreSQL local (profile `local`, nomes próprios do projeto)
POSTGRES_DB=deladopara
POSTGRES_USER=deladopara
POSTGRES_PASSWORD=trocar-localmente
POSTGRES_PORT=55432

# Kafka local (KRaft, 1 nó; dentro do Compose use kafka:29092)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PORT=59092

# Backend
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:8080
APP_MEDIA_DIRECTORY=./data/media
# Chave própria para cifrar códigos de retirada; gere com `openssl rand -base64 32`.
SHIPPING_PICKUP_ENCRYPTION_KEY=

# Frontend (SSR)
FRONTEND_PORT=4200

# Mailpit (e-mail local de demonstração)
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025

# WireMock (simuladores HTTP determinísticos; mappings em infra/local/wiremock)
WIREMOCK_PORT=18443

# Sandbox Asaas (opt-in, somente homologação manual C04/C63)
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# ASAAS_WEBHOOK_TOKEN=

# Sandbox Melhor Envio (opt-in, somente homologação manual C04/C42/C70/C71)
# SHIPPING_MELHOR_ENVIO_ENABLED=false
# SHIPPING_MELHOR_ENVIO_TOKEN=
# SHIPPING_MELHOR_ENVIO_USER_AGENT="De La do Para (email técnico autorizado)"
# Secret do app Melhor Envio para validar X-ME-Signature (não versionar valor real)
# SHIPPING_MELHOR_ENVIO_WEBHOOK_SECRET=

# Túnel HTTPS temporário para webhooks (escolhido em G0, rota mínima)
# TUNNEL_URL=
# Pagamentos (C59): provedor explícito ("simulated" até o adapter Asaas da C63) e worker opt-in
PAYMENTS_PROVIDER=
PAYMENTS_WORKER_ENABLED=false

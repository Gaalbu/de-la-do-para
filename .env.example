# Exemplo de ambiente local — De Lá do Pará
# Copie para `.env` (não versionado) e preencha localmente.
# Nenhum valor real deve ser commitado. Sandbox é opt-in (C04).

# PostgreSQL local (profile `local`, nomes próprios do projeto)
POSTGRES_DB=deladopara
POSTGRES_USER=deladopara
POSTGRES_PASSWORD=trocar-localmente
POSTGRES_PORT=55432

# Kafka local (KRaft, 1 nó; dentro do Compose use kafka:29092)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PORT=59092

# Backend
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:8080
APP_MEDIA_DIRECTORY=./data/media
APP_FRONTEND_BASE_URL=http://localhost:4200
# Gere com: openssl rand -base64 32 (obrigatória para cadastro e worker de e-mail)
APP_DATA_ENCRYPTION_KEY=
IDENTITY_VERIFICATION_TTL=PT30M
IDENTITY_RECOVERY_TTL=PT15M

# Frontend (SSR)
FRONTEND_PORT=4200

# Mailpit (e-mail local de demonstração)
MAILPIT_SMTP_PORT=11025
MAILPIT_HTTP_PORT=18025
NOTIFICATIONS_MAIL_HOST=localhost
NOTIFICATIONS_MAIL_PORT=11025
NOTIFICATIONS_MAIL_USERNAME=
NOTIFICATIONS_MAIL_PASSWORD=
NOTIFICATIONS_MAIL_SMTP_AUTH=false
NOTIFICATIONS_MAIL_SMTP_STARTTLS=false

# WireMock (simuladores HTTP determinísticos; mappings em infra/local/wiremock)
WIREMOCK_PORT=18443

# Sandbox Asaas (opt-in, somente homologação manual C04/C63)
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# ASAAS_WEBHOOK_TOKEN=

# Sandbox Melhor Envio (opt-in, somente homologação manual C04/C42)
# MELHORENVIO_ACCESS_TOKEN=
# MELHORENVIO_ENV=sandbox

# Túnel HTTPS temporário para webhooks (escolhido em G0, rota mínima)
# TUNNEL_URL=
# Pagamentos (C59): provedor explícito ("simulated" até o adapter Asaas da C63) e worker opt-in
PAYMENTS_PROVIDER=
PAYMENTS_WORKER_ENABLED=false
IDENTITY_MAIL_WORKER_ENABLED=false
IDENTITY_MAIL_FROM=no-reply@deladopara.local
IDENTITY_MAIL_WORKER_BATCH_SIZE=10
IDENTITY_MAIL_WORKER_POLL_DELAY=PT2S
IDENTITY_MAIL_WORKER_RETRY_DELAY=PT30S
IDENTITY_MAIL_WORKER_LEASE=PT2M
ORDER_NOTIFICATIONS_MAIL_WORKER_ENABLED=false
ORDER_NOTIFICATIONS_MAIL_WORKER_BATCH_SIZE=10
ORDER_NOTIFICATIONS_MAIL_WORKER_POLL_DELAY=PT2S
ORDER_NOTIFICATIONS_MAIL_WORKER_LEASE=PT2M

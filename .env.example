# Exemplo de ambiente local — De Lá do Pará
# Copie para `.env` (não versionado) e preencha localmente.
# Nenhum valor real deve ser commitado. Sandbox é opt-in (C04).

# PostgreSQL local (profile `local`, nomes próprios do projeto)
POSTGRES_DB=deladopara
POSTGRES_USER=deladopara
POSTGRES_PASSWORD=trocar-localmente

# Kafka local (KRaft, sem ZooKeeper)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Backend
SPRING_PROFILES_ACTIVE=local
APP_BASE_URL=http://localhost:8080

# Frontend (SSR)
FRONTEND_PORT=4200

# Mailpit (e-mail local de demonstração)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Sandbox Asaas (opt-in, somente homologação manual C04/C63)
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# ASAAS_WEBHOOK_TOKEN=

# Sandbox Melhor Envio (opt-in, somente homologação manual C04/C42)
# MELHORENVIO_ACCESS_TOKEN=
# MELHORENVIO_ENV=sandbox

# Túnel HTTPS temporário para webhooks (escolhido em G0, rota mínima)
# TUNNEL_URL=

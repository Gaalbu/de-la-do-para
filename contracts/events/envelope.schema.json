{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deladopara.example/contracts/events/envelope.schema.json",
  "title": "Envelope de eventos internos",
  "description": "Envelope mínimo do plano §5.5 (C11). Contratos de evento versionados chegam com SPEC-eventing (C45).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "aggregateId": { "type": "string", "minLength": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 0 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
